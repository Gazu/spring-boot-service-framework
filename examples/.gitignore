# Ignore generated files inside example applications.

# Build outputs
build/
/out/
target/
.gradle/

# Logs generated by local example runs
logs/
log/
*.log
*.log.*
spring.log
application.log

# Local runtime files
tmp/
temp/
*.tmp
*.pid

# Local configuration and secrets
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-local.properties
*.keystore
*.jks
*.p12
*.pem
*.key
*.crt

# IDE files created from opening examples directly
.idea/
*.iml
.vscode/
.project
.classpath
.settings/
